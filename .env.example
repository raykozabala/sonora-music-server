# Sonora Music Server - Variables de Entorno
# Copia este archivo a .env y edita los valores según tu entorno

# Puerto del servidor (default: 3000)
PORT=3000

# Modo del servidor: 'local', 'render' o 'northflank'
SERVER_MODE=local

# URL base del servidor (para que la app se conecte)
# En local usa tu IP o host de la red local: http://MacBook-Air-de-Rayko.local:3000
SERVER_URL=http://MacBook-Air-de-Rayko.local:3000

# Directorio de datos persistente (base de datos y archivos)
DATA_DIR=./

# Directorio de música (relativo o absoluto)
MUSIC_DIR=./music

# URL del servidor Render (si usas modo render como respaldo)
RENDER_URL=https://sonora-music-b1ee.onrender.com

# URL del servidor Northflank (si usas modo northflank)
NORTHFLANK_URL=
